# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local

# Your OpenAI API key — must belong to the same org/project as your Agent Builder workflow.
# Get it from: https://platform.openai.com/api-keys
# NOTE: if OPENAI_API_KEY is already set in your shell session it will override this value.
# Run: unset OPENAI_API_KEY  before starting the dev server.
OPENAI_API_KEY=sk-proj-...

# Workflow ID from Agent Builder — must start with wf_  (NOT an asst_ Assistant ID).
# Go to: https://platform.openai.com/agent-builder → open your workflow → Publish → copy ID.
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=wf_...

# Optional: override the ChatKit API base URL (leave commented out unless you need a proxy).
# CHATKIT_API_BASE=https://api.openai.com

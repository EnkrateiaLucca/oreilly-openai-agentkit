# Copy to .env; never commit credentials. Keep this file on the backend only.
OPENAI_API_KEY=
# One configurable model for all three runtimes; preflight checks actual account access.
OPENAI_MODEL=gpt-6-luna
# Optional current published standard rates for an approximate model-only cost.
# Leave blank for unknown. Sandbox/tool/cache-write/tier costs are not included.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Backend URL is used by Streamlit, never by the model.
COURSE_BACKEND_URL=http://127.0.0.1:8000
# Optional per-user auth config; otherwise run `python -m course access`.
# COURSE_USERS_JSON={"teacher":{"token":"generate-a-random-token","can_publish":true}}
